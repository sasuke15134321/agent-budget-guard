# Agent Budget Guard API Environment Variables

# Anthropic API Configuration (if needed for analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/budget_guard
# OR use individual components:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=budget_guard
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password

# x402 Payment Configuration
WALLET_ADDRESS=0x1234567890123456789012345678901234567890
NETWORK=base-mainnet
PRICE_USDC=0.03
TEST_MODE=true

# Budget Configuration
DEFAULT_DAILY_LIMIT=5.00
DEFAULT_MONTHLY_LIMIT=150.00

# Server Configuration
PORT=8000